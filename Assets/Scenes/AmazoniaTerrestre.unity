--- !u!114 &1899699686
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 1899699682}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: e3f9153ce6ffac248b0de6174932c492, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::Amazonia.AdventureDirector
  landIntro:
  - speaker: Narrador
    text: "El agua estaba m\xE1s turbia de lo normal. La selva parec\xEDa contener
      la respiraci\xF3n."
    caiman: 0
  - speaker: "Caim\xE1n"
    text: "\xA1Alto ah\xED! Nadie cruza mi orilla sin permiso."
    caiman: 1
  - speaker: Capibara
    text: "Solo busco saber qui\xE9n est\xE1 ensuciando el lago."
    caiman: 0
  - speaker: "Caim\xE1n"
    text: "Eso dicen todos los que llegan. \xA1Fuera de mi territorio!"
    caiman: 1
  escape:
  - speaker: Capibara
    text: "\xBFEso cuenta como ganar?"
    caiman: 0
  - speaker: "Caim\xE1n"
    text: "No cantes victoria... aqu\xED abajo mando yo."
    caiman: 1
  immersion:
  - speaker: Capibara
    text: "No puedo dejarlo escapar... y todav\xEDa necesito respuestas."
    caiman: 0
  waterIntro:
  - speaker: Narrador
    text: "Bajo las ra\xEDces, el lago ocultaba cicatrices que la superficie no mostraba."
    caiman: 0
  - speaker: "Caim\xE1n"
    text: "Entraste a mis aguas. Aqu\xED tus saltos no servir\xE1n."
    caiman: 1
  - speaker: Capibara
    text: "Entonces tendr\xE9 que aprender a nadar m\xE1s r\xE1pido."
    caiman: 0
  ending:
  - speaker: Narrador
    text: "Entre los sedimentos yac\xEDan restos de metal y marcas de maquinaria.
      El verdadero peligro no ten\xEDa escamas."
    caiman: 0
  - speaker: Capibara
    text: "Esto no termin\xF3 aqu\xED... alguien est\xE1 da\xF1ando la selva."
    caiman: 0
  capyPortrait: {fileID: 21300000, guid: 6c80335a527153443aa3952955d9ec94, type: 2}
  caimanPortrait: {fileID: 21300000, guid: 1f4a55cea69dcfe4ab22ba5ef11fac4e, type: 2}
  capsuleFull: {fileID: 21300000, guid: a521a94aef1cafe45a1b8983b2e0143f, type: 2}
  capsuleEmpty: {fileID: 21300000, guid: 5be36b9a398ff614fbb95a6bc22ec3ea, type: 2}
  dialogFrame: {fileID: 0}
  escapeClip: {fileID: 32900000, guid: 7979d54c4179c34438ffd1fcb1af2a49, type: 3}
  immersionClip: {fileID: 0}
  escape_video_path: 
  immersion_video_path: 
